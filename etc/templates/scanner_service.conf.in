[group:test_tube]
programs=webUI,planification,services

[program:webUI]
process_name=%(program_name)s
priority=500

directory=@ROOT@/test_tube_scanner
command=@ROOT@/test_tube_scanner/@WEB_CMD@

user=@USER@
group=@USER@
stopasgroup=true
stopsignal=SIGINT
autostart=true
autorestart=true
redirect_stderr=true

[program:planification]
process_name=%(program_name)s
priority=800
directory=@ROOT@/test_tube_scanner
command=@ROOT@/.venv/bin/celery -A home beat -l info
user=@USER@
group=@USER@
stopasgroup=true
stopsignal=SIGINT
autostart=true
autorestart=true
redirect_stderr=true

[program:services]
process_name=%(program_name)s
priority=900
directory=@ROOT@/test_tube_scanner
command=@ROOT@/test_tube_scanner/run-workers.sh
user=@USER@
group=@USER@
stopasgroup=true
stopsignal=SIGINT
autostart=true
autorestart=true
redirect_stderr=true

